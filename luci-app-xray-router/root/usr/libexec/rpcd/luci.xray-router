#!/usr/bin/lua
-- XRAY_ROUTER_PROJECT: authenticated rpcd executable plugin and async worker.
local json = require "luci.jsonc"
local fs = require "nixio.fs"
local nixio = require "nixio"
local conf, work = "/etc/xray-router", "/tmp/xray-router-ui"
local lock = work .. "/lock"
local function quote(s) return "'" .. s:gsub("'", "'\\''") .. "'" end
local function mkdir(path)
    local info = fs.lstat(path)
    if info then
        assert(info.type == "dir" and info.uid == 0, "Unsafe directory " .. path)
        assert(fs.chmod(path, 448), "Cannot protect " .. path)
    else assert(fs.mkdir(path, 448), "Cannot create " .. path) end
end
local function atomic(path, text)
    local tmp = path .. ".new"
    fs.unlink(tmp)
    local fd = assert(nixio.open(tmp, "w", 384), "Cannot write " .. tmp)
    local ok = fd:writeall(text)
    local synced = ok and fd:sync()
    fd:close()
    assert(ok and synced, "Cannot complete write " .. tmp)
    assert(fs.rename(tmp, path), "Cannot replace " .. path)
end
local function command(cmd)
    local pipe = assert(io.popen(cmd .. " 2>&1; printf '\\nXRAY_UI_EXIT=%s\\n' \"$?\""))
    local out = pipe:read("*a") or ""
    pipe:close()
    local code = tonumber(out:match("\nXRAY_UI_EXIT=(%d+)\n$")) or 1
    return code, out:gsub("\nXRAY_UI_EXIT=%d+\n$", ""):sub(-65536)
end
local function test(command_line) local code = command(command_line); return code == 0 end
local backend = dofile("/usr/libexec/xray-router/ui.lua").new({
    conf = conf, work = work, json = json, read = fs.readfile, mkdir = mkdir,
    atomic = atomic, remove = fs.unlink,
    running = function() return test("/etc/init.d/xray-router running") end,
    enabled = function() return test("/etc/init.d/xray-router enabled") end,
    capture_active = function() return fs.stat("/tmp/xray-router-inspector/lock") ~= nil end,
    revision = function()
        local code, value = command("sha256sum /etc/xray-router/config.json /etc/xray-router/settings.conf")
        assert(code == 0, "Cannot fingerprint configuration")
        return value
    end,
    run = function(action, directory)
        local prefix = directory and ("XRAY_ROUTER_CONF_DIR=" .. quote(directory) .. " ") or ""
        return command(prefix .. "/usr/sbin/xrayctl " .. quote(action) .. (action == "logs" and " 200" or ""))
    end
})
local function job()
    local raw = fs.readfile(work .. "/result")
    if fs.stat(lock) then
        local pid = tonumber((fs.readfile(lock .. "/pid")))
        if pid and nixio.kill(pid, 0) then return { busy = true } end
        -- Allow the newly forked worker time to publish its PID.
        local stat = fs.stat(lock)
        if stat and os.time() - stat.mtime < 10 then return { busy = true } end
        fs.unlink(lock .. "/pid")
        fs.unlink(lock .. "/pid.new")
        fs.rmdir(lock)
        return { busy = false, code = 1, output = "Management worker stopped unexpectedly. Reload configuration and check whether recovery is required." }
    end
    return raw and json.parse(raw) or { busy = false }
end
local function worker()
    atomic(lock .. "/pid", tostring(nixio.getpid()))
    local request
    local ok, result = pcall(function()
        request = assert(json.parse(assert(fs.readfile(work .. "/request"))))
        return backend.perform(request)
    end)
    result = ok and result or { code = 1, output = tostring(result) }
    result.busy = false
    result.action = request and request.action
    atomic(work .. "/result", json.stringify(result))
    fs.unlink(work .. "/request")
    fs.unlink(lock .. "/pid")
    fs.rmdir(lock)
end
local function start(request)
    mkdir(work)
    assert(not job().busy, "Another management operation is running")
    assert(fs.mkdir(lock, 448), "Another management operation is running")
    local ok, err = pcall(function()
        atomic(work .. "/request", json.stringify(request))
        fs.unlink(work .. "/result")
        local pid = assert(nixio.fork(), "Cannot start management worker")
        if pid == 0 then
            nixio.setsid()
            local null = assert(nixio.open("/dev/null", "r+"))
            nixio.dup(null, nixio.stdin)
            nixio.dup(null, nixio.stdout)
            nixio.dup(null, nixio.stderr)
            null:close()
            nixio.exec("/usr/bin/lua", "/usr/libexec/rpcd/luci.xray-router", "worker")
            os.exit(1)
        end
    end)
    if not ok then fs.rmdir(lock); error(err, 0) end
    return { busy = true }
end
local signatures = '{"get":{},"status":{},"job":{},"diagnostics":{"action":""},"start":{"action":"","config":"","revision":"","settings":{}}}'
if arg[1] == "list" then print(signatures)
elseif arg[1] == "worker" then worker()
elseif arg[1] == "call" then
    local ok, response = pcall(function()
        local raw = io.read(1048577) or "{}"
        assert(#raw <= 1048576, "Request too large")
        local request = assert(json.parse(raw), "Invalid request")
        if arg[2] == "get" then return backend.get()
        elseif arg[2] == "status" then return backend.status()
        elseif arg[2] == "job" then return job()
        elseif arg[2] == "diagnostics" then return backend.diagnostics(request.action)
        elseif arg[2] == "start" then return start(request) end
        error("Unknown RPC method")
    end)
    print(json.stringify(ok and response or { error = tostring(response) }))
end
